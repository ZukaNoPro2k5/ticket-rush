# ═══════════════════════════════════════════════════════
# TicketRush Frontend — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env.local and fill with real values.
# NEVER commit .env.local to git.

# ─── NextAuth ────────────────────────────────────────
# Generate a 32+ char random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ─── Backend API ─────────────────────────────────────
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Google OAuth ────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook OAuth ──────────────────────────────────
# Create app at https://developers.facebook.com/apps
# Valid OAuth Redirect URIs: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Email (optional) ────────────────────────────────
# Sign up free at https://resend.com — handles welcome/confirmation emails.
# If empty, backend will log emails to console instead.
RESEND_API_KEY=
EMAIL_FROM=TicketRush <no-reply@ticketrush.vn>
